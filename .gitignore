# ────────────────────────────────────────────────────────────
# Runner Notes is currently a private project.
# This .gitignore deliberately hides everything except the
# README and the assets folder so the repo can be made public
# without exposing source code.
# ────────────────────────────────────────────────────────────

# Hide everything at the repo root by default
/*

# …but keep these
!/.gitignore
!/README.md
!/assets
!/LICENSE

# Always ignore inside assets — these don't belong on a public repo
assets/.DS_Store
assets/**/.DS_Store

# Standard ignores (kept for safety even though /* covers them)
node_modules/
.expo/
dist/
web-build/
expo-env.d.ts
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
*.pem
.env*.local
*.tsbuildinfo
app-example
/ios
/android
