{
  "expo": {
    "name": "runner-notes",
    "slug": "runner-notes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "runnernotes",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bishesh-panthos.runner-notes",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We need your location to track your runs and calculate pace.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "We need your location to track your runs in the background and calculate pace accurately.",
        "NSCameraUsageDescription": "We need camera access to capture Run Snaps during your runs.",
        "NSPhotoLibraryUsageDescription": "We need photo library access to save and select Run Snaps.",
        "UIBackgroundModes": [
          "location",
          "location"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.bisheshpanthos.runnernotes"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Runner Notes to use your location to track your runs.",
          "locationAlwaysPermission": "Allow Runner Notes to use your location to track your runs in the background.",
          "locationWhenInUsePermission": "Allow Runner Notes to use your location to track your runs."
        }
      ],
      "expo-apple-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Runner Notes to capture Run Snaps during your runs."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Runner Notes to access your photos to add Run Snaps."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "01f17c60-29ef-465c-bf99-1a6b214bb9ba"
      }
    }
  }
}
